spring:
  datasource:
    url: jdbc:mysql://localhost:3306/myboard  # MySQL의 데이터베이스 주소
    username: Hyerin
    password: 0417
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    database-platform: org.hibernate.dialect.MySQL8Dialect
    hibernate:
      ddl-auto: update  # 테이블 자동 생성 (create / update / none 선택 가능)
    show-sql: true  # 실행되는 SQL문을 콘솔에 출력
    properties:
      hibernate:
        format_sql: true  # SQL문을 보기 좋게 정렬
